# JobMarket Pulse environment template.
# Copy to `.env` (git-ignored) and fill in values locally. NEVER commit real values.
# Three separate PostgreSQL roles are used; each process receives only the URL it needs.

# Read-only role used by the public FastAPI service (SELECT on tables/views only).
# Use the Neon *pooled* host (contains "-pooler") in production.
API_DATABASE_URL=postgresql+psycopg://jmp_api_ro:<password>@<host>/<database>?sslmode=require

# Limited writer role used by the ingestion pipeline (CLI / GitHub Actions).
INGEST_DATABASE_URL=postgresql+psycopg://jmp_ingest:<password>@<host>/<database>?sslmode=require

# Owner/migration role used ONLY by Alembic migrations and role provisioning.
# Use the Neon *direct* (non-pooled) host for migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://<owner_role>:<password>@<host>/<database>?sslmode=require

# Safety check for migrations: the database name the migration script must find.
EXPECTED_DATABASE_NAME=jobmarket_pulse

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173

# local | ci | production
APP_ENV=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional: PostgreSQL test database for integration tests (destroyed and recreated by tests).
# Must point to a disposable database whose name contains "test".
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:55432/jmp_test
